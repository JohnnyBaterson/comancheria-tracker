{
  "name": "comancheria-tracker",
  "version": "1.18.0",
  "private": true,
  "type": "module",
  "description": "Local-first Comancheria board-game companion",
  "scripts": {
    "test": "node --test tests/*.regression.mjs tests/*.acceptance.mjs",
    "test:browser": "node --test scripts/browser-journey.mjs",
    "test:structural": "node scripts/release-check.mjs",
    "preflight": "node scripts/product-gate.mjs",
    "check": "npm run test:structural",
    "test:rules": "node --test tests/*.regression.mjs",
    "test:acceptance": "node --test tests/*.acceptance.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
